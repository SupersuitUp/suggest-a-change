{
  "name": "@supersuit/suggest-a-change",
  "version": "0.1.0",
  "description": "The report format and flow behind a Suggest a change button: what a report is, who acts at each step, and the checks every app runs. Zero dependencies.",
  "type": "module",
  "bin": {
    "suggest-a-change": "bin/suggest-a-change.mjs"
  },
  "exports": {
    ".": "./src/contract.mjs",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "test:client": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run test:client && npm run build && npm test && node bin/suggest-a-change.mjs --help"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/suggest-a-change.git"
  },
  "dependencies": {},
  "keywords": [
    "feedback",
    "suggest-a-change",
    "report",
    "contract",
    "supersuit"
  ],
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
